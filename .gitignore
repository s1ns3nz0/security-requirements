# Sensitive derivation state, when this plugin is run against a repository.
# The profile, threat model, and implementation status together describe where
# data lives and which controls are not yet in place. Git history survives
# deletion of the files.
.security-requirements/

__pycache__/
*.pyc
.pytest_cache/

# Coverage measurement output, not part of the repository.
.coverage
htmlcov/
.coverage.*

# Local isolated development worktrees.
.worktrees/

# Agent tooling installed for local authoring, except for the Codex marketplace
# manifest that distributes this plugin.
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
.claude/
skills-lock.json
